# Copy to .env and fill in (for local reference). On Heroku, set these via
# `heroku config:set` instead of a dotenv file.
# Generate a key with: openssl rand -hex 32
# Used by both egress proxy (?key=) and doodstream resolver (X-Proxy-Key header).
EGRESS_PROXY_KEY=

# Comma-separated extra allowed host suffixes (optional).
# Example: my-cdn.com,another-cdn.net
# Only applies to egress proxy (/?url=), not the resolver.
PROXY_ALLOWED_DOMAINS=
